# ==============================================================================
# OFLINK Environment Configuration
# ==============================================================================

# Local Dev Server Port
PORT=3000

# Node Identification Defaults
DEFAULT_LOCAL_NODE_ID="OFLINK-A"
DEFAULT_TARGET_NODE_ID="OFLINK-B"

# BLE GATT Service & Characteristic UUIDs
# MUST MATCH ESP32 FIRMWARE EXACTLY
BLE_SERVICE_UUID="6d7f1000-7c8a-4d91-9b61-1b632fcb1234"
BLE_TX_CHAR_UUID="6d7f1001-7c8a-4d91-9b61-1b632fcb1234"
BLE_RX_CHAR_UUID="6d7f1002-7c8a-4d91-9b61-1b632fcb1234"

# LoRa Hardware Parameters (ESP32 + SX1278)
LORA_FREQUENCY_MHZ=433.05
LORA_SPREADING_FACTOR=9
LORA_BANDWIDTH_KHZ=125.0
LORA_CODING_RATE="4/7"
LORA_TX_POWER_DBM=10
